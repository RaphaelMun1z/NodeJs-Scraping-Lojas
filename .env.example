# ================================================================
# Aplicação
# ================================================================
PORTA_API=3000

# Banco local. Em Docker, use mongodb://mongodb:27017/scraping_lojas.
MONGODB_URI=mongodb://127.0.0.1:27017/scraping_lojas

# Coleta e navegador: fontes, URLs, logos e seletores são cadastrados pela área administrativa.
SALVAR_COLETA=false
REQUEST_TIMEOUT_MS=30000
USER_AGENT=Mozilla/5.0 (compatible; ScrapingLojas/2.0)
NAVEGADOR_VISIVEL=false
NAVEGADOR_PAUSA_MS=3000
NAVEGADOR_ESPERA_VERIFICACAO_MS=60000

# Agendamento
CRON_EXPRESSAO=*/30 * * * *
CRON_FUSO_HORARIO=America/Sao_Paulo
EXECUTAR_COLETA_AO_INICIAR=true

# Logs, autenticação e retenção
LOG_LEVEL=info
LOG_PRETTY=true
AUTENTICACAO_COOKIE_SECURE=false
SCRAPING_RETENCAO_EXECUCOES=100
SCRAPING_RETENCAO_LOGS=2000
HISTORICO_PRECO_RETENCAO_DIAS=730

# Elasticsearch e matching semântico
# Deixe false se não quiser usar matching semântico.
ELASTICSEARCH_HABILITADO=false
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDICE=produtos
ELASTICSEARCH_API_KEY=
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_API_KEY=
MATCHING_CANDIDATOS=20
MATCHING_PESO_VETOR=0.45
MATCHING_PESO_TEXTO=0.30
MATCHING_PESO_TOKENS=0.25
MATCHING_THRESHOLD=0.78

# Ollama: análise opcional de seletores CSS
CLASSIFICADOR_URL=http://127.0.0.1:11434/api/generate
ANALISADOR_SELETORES_MODELO=gemma3:4b
ANALISE_SELETORES_TIMEOUT_MS=120000
